# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM (externally hosted) ---
HIVE_LLM_API_KEY=
HIVE_LLM_BASE_URL=https://api.openai.com/v1
HIVE_LLM_MODEL=gpt-4o

# --- Telegram data plane (Telethon userbot: the user's OWN account) ---
# Obtain API_ID / API_HASH from https://my.telegram.org
HIVE_TG_API_ID=
HIVE_TG_API_HASH=
HIVE_TG_PHONE=
# Path to the encrypted session store (see security/session_store.py)
HIVE_TG_SESSION_PATH=./secrets/user.session
# Passphrase used to encrypt the session file at rest
HIVE_SESSION_PASSPHRASE=

# --- Telegram control plane (Bot API) ---
HIVE_CONTROL_BOT_TOKEN=
# Telegram user ID allowed to control the bot (the operator)
HIVE_OPERATOR_ID=

# --- Vector store ---
HIVE_QDRANT_URL=http://localhost:6333

# --- Signing (RSA private key path; keep outside repo) ---
HIVE_SIGNING_KEY_PATH=./secrets/signing_key.pem

# --- Behaviour ---
HIVE_DEFAULT_PERSONA=confused_elderly
HIVE_MAX_TURNS=60
HIVE_MAX_SESSION_MINUTES=120
