# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM (Ollama Cloud, OpenAI-compatible) ---
# Generate an API key at https://ollama.com
HIVE_LLM_API_KEY=
HIVE_LLM_BASE_URL=https://ollama.com/v1
# Cost-tiered agent models: cheap = default, strong = escalation, light = verdict
HIVE_LLM_MODEL_CHEAP=glm-5.1:cloud
HIVE_LLM_MODEL_STRONG=glm-5.2:cloud
HIVE_LLM_MODEL_LIGHT=glm-5.1:cloud
# Vision model for L3 media fallback
HIVE_VISION_MODEL=qwen3.5:cloud
HIVE_LOG_LEVEL=INFO

# Optional: increases Hugging Face Hub download rate limits
HF_TOKEN=

# --- Telegram data plane (Telethon userbot: the user's OWN account) ---
# Obtain API_ID / API_HASH from https://my.telegram.org
HIVE_TG_API_ID=
HIVE_TG_API_HASH=
HIVE_TG_PHONE=
# Path to the encrypted session store (see security/session_store.py)
HIVE_TG_SESSION_PATH=./secrets/user.session
# Passphrase used to encrypt the session file at rest
HIVE_SESSION_PASSPHRASE=

# --- Telegram control plane (Bot API) ---
HIVE_CONTROL_BOT_TOKEN=
# Telegram user ID allowed to control the bot (the operator)
HIVE_OPERATOR_ID=

# --- Vector store ---
HIVE_QDRANT_URL=http://localhost:6333

# --- Relational store (takeover history) ---
# Compose supplies HIVE_DATABASE_URL to the backend using this password.
HIVE_POSTGRES_PASSWORD=hive-local
HIVE_DATABASE_URL=

# --- Web control panel (always enabled on localhost) ---
# Optional persistent token for headless/API clients. Browsers use an ephemeral token.
HIVE_PANEL_TOKEN=
HIVE_PANEL_HOST=127.0.0.1
HIVE_PANEL_PORT=9130
# Keep false unless a container publishes this port to host loopback only.
HIVE_PANEL_ALLOW_NON_LOOPBACK=false

# --- Signing (RSA private key path; keep outside repo) ---
HIVE_SIGNING_KEY_PATH=./secrets/signing_key.pem

# --- Behaviour ---
HIVE_DEFAULT_PERSONA=confused_elderly
HIVE_MAX_TURNS=60
HIVE_MAX_SESSION_MINUTES=120
