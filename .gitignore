# --- Secrets & credentials (SECURITY-CRITICAL: never commit) ---
# Telethon session file = full credential to the user's Telegram account.
*.session
*.session-journal
# RSA / signing keys
*.pem
*.key
*.pub
keys/
secrets/
# Environment
.env
.env.*
!.env.example

# --- Evidence output (may contain third-party PII; keep local) ---
evidence/
*.evidence.pdf
evaluation/results/
tmp/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
node_modules/
.playwright-cli/

# --- Tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local data stores ---
qdrant_storage/
*.sqlite3

# --- IDE / OS ---
.idea/
.vscode/
.claude/
.DS_Store

# --- Local generated artifacts and document scratch work ---
/output/
/docs/_docx_work/
/docs/_xlsx_work/

*.dot
*.png
*.svg
