{
  "schema_version": 1,
  "description": "Sanitized, synthetic regression cases for deterministic HVI extraction.",
  "cases": [
    {
      "id": "en-maybank-account",
      "language": "en",
      "text": "Transfer it to Maybank account 1234567890.",
      "expected": [
        {"kind": "bank_name", "value": "Maybank"},
        {"kind": "bank_account", "value": "1234567890"}
      ]
    },
    {
